/*
Exercise 12-3: Design an airline reservation data structure that contains the
following data:
· Flight number
· Originating airport code (three characters)
· Destination airport code (three characters)
· Starting time
· Arrival time
*/

#include <stdio.h>
#include <stdint.h>
#include <stdbool.h>
#include <time.h>

#define AIRPORT_CODE_LEN 3

/**
 * @brief Represents time of day and date for flight scheduling.
 * Wraps stdlib's struct tm or can be customized for compact systems.
 */
typedef struct tm FlightTime;

/**
 * @brief Operational status of a reservation record.
 */
typedef enum {
    FLIGHT_STATUS_SCHEDULED,
    FLIGHT_STATUS_BOARDING,
    FLIGHT_STATUS_IN_FLIGHT,
    FLIGHT_STATUS_ARRIVED,
    FLIGHT_STATUS_CANCELLED,
    FLIGHT_STATUS_DELAYED
} FlightStatus;

/**
 * @brief Primary Airline Reservation Data Structure.
 */
typedef struct {
    FlightTime departure_time;  /* Departure timestamp (date & time) */
    FlightTime arrival_time;    /* Arrival timestamp (date & time)   */
    
    uint16_t   flight_number;   /* Flight number (e.g., 101 to 9999) */
    
    char origin[AIRPORT_CODE_LEN + 1];      /* 3-letter IATA code + '\0' */
    char destination[AIRPORT_CODE_LEN + 1]; /* 3-letter IATA code + '\0' */
    
    FlightStatus status;        /* Current status of the reservation */
} FlightReservation;

/* ---------------------- Helper Functions ---------------------- */

/**
 * @brief Utility function to print flight reservation details cleanly.
 */
void print_reservation(const FlightReservation *flight) {
    if (flight == NULL) {
        printf("(null reservation)\n");
        return;
    }

    char dep_buf[32];
    char arr_buf[32];

    /* Format time strings using standard strftime */
    strftime(dep_buf, sizeof(dep_buf), "%Y-%m-%d %H:%M", &flight->departure_time);
    strftime(arr_buf, sizeof(arr_buf), "%Y-%m-%d %H:%M", &flight->arrival_time);

    printf("========================================\n");
    printf(" Flight Number : %u\n", flight->flight_number);
    printf(" Route         : %s -> %s\n", flight->origin, flight->destination);
    printf(" Departure     : %s\n", dep_buf);
    printf(" Arrival       : %s\n", arr_buf);
    printf(" Record Size   : %zu bytes\n", sizeof(FlightReservation));
    printf("========================================\n");
}

/* ---------------------- Test Harness ---------------------- */

int main(void) {
    /* Sample Test Record Initialization */
    FlightReservation res = {
        .flight_number = 402,
        .origin = "TLV",
        .destination = "JFK",
        .status = FLIGHT_STATUS_SCHEDULED,
        .departure_time = {
            .tm_year = 2026 - 1900, /* Years since 1900 */
            .tm_mon  = 9 - 1,        /* September (0-indexed) */
            .tm_mday = 15,
            .tm_hour = 10,
            .tm_min  = 30,
            .tm_sec  = 0
        },
        .arrival_time = {
            .tm_year = 2026 - 1900,
            .tm_mon  = 9 - 1,
            .tm_mday = 15,
            .tm_hour = 22,
            .tm_min  = 15,
            .tm_sec  = 0
        }
    };

    printf("=== Airline Reservation Data Structure Test ===\n\n");
    print_reservation(&res);

    return 0;
}
